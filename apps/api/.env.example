# App
NODE_ENV=development
PORT=3001
WEB_ORIGIN=http://localhost:3000

# Database (Postgres)
# Opção 1 (Produção / Neon): Connection string única com SSL
# DATABASE_URL=postgresql://neondb_owner:password@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require
# DB_SSL=true

# Opção 2 (Desenvolvimento Local / Docker): Parâmetros separados
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=estudeai

# Auth
# Gere um segredo forte: openssl rand -base64 32
JWT_ACCESS_SECRET=changeme
JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=7

# Gemini AI (FR-02.1)
# Chave da API do Gemini (obrigatória para gerar roadmaps). Obtenha em https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Modelo usado na geração (Structured Output). Default: gemini-flash-latest
# (alias que acompanha o flash atual; evita 404 quando uma versão fixa é aposentada).
# Alternativas GA testadas: gemini-3.6-flash, gemini-3.5-flash.
GEMINI_MODEL=gemini-flash-latest
# Timeout (ms) da chamada ao Gemini antes de responder 504 ao frontend.
GEMINI_TIMEOUT_MS=20000

# Recursos de estudo por tópico (Etapa 8)
# Chave da YouTube Data API v3, para buscar vídeos e playlists reais.
# Crie em https://console.cloud.google.com/apis/credentials (ative "YouTube Data API v3").
# ATENÇÃO à cota: search.list custa 100 das 10.000 unidades diárias gratuitas — ou seja,
# ~100 buscas/dia. Sem esta chave o roadmap continua sendo gerado, só que sem vídeos.
YOUTUBE_API_KEY=
# false desliga a busca de recursos por completo (útil em dev, para não gastar cota).
RESOURCE_DISCOVERY_ENABLED=true
# Teto de tempo (ms) da busca de recursos por roadmap. Ao estourar, os tópicos restantes
# ficam sem recursos e são completados no próximo cache hit — a geração nunca falha.
RESOURCE_DISCOVERY_BUDGET_MS=40000
# Intervalo (ms) entre tópicos, para não estourar o rate limit da YouTube API.
RESOURCE_DISCOVERY_DELAY_MS=250
# Timeout (ms) de cada busca (YouTube e Gemini com grounding).
RESOURCE_SEARCH_TIMEOUT_MS=10000
# Timeout (ms) da validação HTTP de cada link antes de persistir.
RESOURCE_URL_TIMEOUT_MS=3000
